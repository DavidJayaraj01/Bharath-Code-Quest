# ── VitalBridge Backend Environment Variables ──
# Copy this file to .env and fill in values

# App
SECRET_KEY=change-me-to-a-random-64-char-hex-string
DEBUG=true

# Database (SQLite for local dev; switch to postgres:// for production)
DATABASE_URL=sqlite:///./vitalbridge.db

# Grok AI (xAI) — required for triage chat
GROK_API_KEY=your-grok-api-key-here
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19006

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# IoT Simulator
IOT_DEMO_DAY_SECONDS=120
